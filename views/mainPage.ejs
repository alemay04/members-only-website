<!-- views/mainPage.ejs -->
<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
  </head>
<body>
    <header>
        <a href="/"><h1>Club2Secret</h1></a>
        
        <div class="right_header_section">
            <% if (currentUser){ %>
            <h2>Hi, <%= currentUser.username %> </h2>
            <% if (currentUser.member_ship_status == 'non-user') { %>
            <a href="/member">Member?</a>
            <% } %>
            <% if (currentUser.member_ship_status == 'user') { %>
            <a href="/member">Admin?</a>
            <% } %>
            <a href="/message">Post a message !</a>
            <a href="/logout">Log Out</a>
            <% } else { %>
                <a href="/signup">Sign Up</a>
                <a href="/login">Login</a>
            <% } %>
        </div>
    </header>
    <main>
        <section class="message-section">

        <h1><%= title %></h1>

        <%
        const isMember =
        currentUser &&
        (currentUser.member_ship_status === "user" || currentUser.member_ship_status === "admin") ;
        %>
        <%
        const isAdmin =
        currentUser &&
        currentUser.member_ship_status === "admin";
        %>

        <% messages.forEach(message => { %>
            <div class="message-post">
                <div class="message-header">
                    <h3>
                        <%= message.title %>
                    </h3>
                    <h4>
                        <%= isMember? message.username : "******" %>
                    </h4>

                    <p>
                        <%= isMember? new Date(message.timestamp).toLocaleString('fr-CA', {year: 'numeric',month: '2-digit',day: '2-digit',hour: '2-digit',minute: '2-digit'}) : "****/**/**" %>
                    </p>
                    <% if (isAdmin) { %>
                    <form action="/delete/<%= message.messageid %>" method="post">
                        <button type="submit" class="message-delete-btn">delete</button>
                    </form>
                    <% } %>
                </div>

                <div class="message-content">
                    <p><%= message.description %></p>
                </div>
            </div>
        <% }); %>

        </section>
    </main>
</body>
</html>